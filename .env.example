# Local development: copy to .env. Never upload .env or paste secrets into dist/.
NODE_ENV=development
PORT=5173
HOST=127.0.0.1
SMART_MONITOR_DB=data/monitor.sqlite

# Optional locally; REQUIRED in production. Generate with npm run secrets.
APP_PASSWORD=
SESSION_SECRET=
IOT_API_KEY=

# This MVP has one registered device. Keep SM-001.
IOT_DEVICE_ID=SM-001

# REQUIRED in production: hosted, persistent database; no SQLite file fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# On Render leave unset: RENDER_EXTERNAL_URL is supplied automatically.
# For a custom domain set https://your-domain.example (no trailing path).
PUBLIC_ORIGIN=
# Render configuration: NODE_ENV=production, HOST=0.0.0.0, PORT=10000,
# NODE_VERSION=24.19.0. Do not upload this local .env to Render.
